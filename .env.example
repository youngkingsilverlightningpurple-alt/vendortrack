# ============================================================
# VendorTrack Environment Configuration
# ============================================================
# IMPORTANT: This file contains PLACEHOLDER values only.
# Never commit real credentials to version control.
# Copy this file to .env.local and fill in real values.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=9002
LOG_LEVEL=debug
NEXT_PUBLIC_LOG_LEVEL=debug

# ---- AI / Genkit ----
# Google Gemini API key for AI product description generation
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Stripe (Payment Processing) ----
# Stripe SECRET key — SERVER-ONLY. Never expose to client bundle.
# Test mode: sk_test_... | Live mode: sk_live_...
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe PUBLISHABLE key — safe for client bundle (NEXT_PUBLIC_ prefix).
# Test mode: pk_test_... | Live mode: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret — SERVER-ONLY.
# Obtain from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# ---- Supabase (Database & Auth) ----
# Supabase project URL — safe for client bundle (NEXT_PUBLIC_ prefix).
# Obtain from: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase ANON key — safe for client bundle (NEXT_PUBLIC_ prefix).
# Respects Row Level Security policies.
# Obtain from: Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — SERVER-ONLY. Never expose to client bundle.
# Bypasses ALL Row Level Security. Equivalent to admin/database root.
# Obtain from: Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (Caching) ----
# Redis connection URL (Upstash or local Redis)
# Format: redis://[:password@]host:port
REDIS_URL=

# ---- Monitoring (Sentry) ----
# Sentry DSN for error tracking (leave empty to disable)
# Obtain from: https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---- Monitoring (OpenTelemetry) ----
# OTLP collector endpoint for distributed tracing (leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vendortrack

# ---- CORS ----
# Comma-separated list of allowed origins (leave empty for same-origin)
CORS_ALLOWED_ORIGINS=

# ---- Cookie Security ----
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ---- Cron Jobs ----
# Secret for verifying Vercel Cron requests
CRON_SECRET=

# ---- Monitoring (Alertmanager) ----
# Secret for Alertmanager webhook authentication
# Falls back to CRON_SECRET if not set
ALERTMANAGER_SECRET=

# Prometheus bearer token for scraping /api/performance
PROMETHEUS_BEARER_TOKEN=

# ---- Algolia (Search — Optional) ----
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=

# ---- Feature Flags (Environment Overrides) ----
# Override individual feature flags via environment variables
# Format: FEATURE_<FLAG_NAME>=true|false
# Example: FEATURE_REDIS_CACHING=true
# FEATURE_STRIPE_CONNECT=true
# FEATURE_AI_PRODUCT_DESCRIPTIONS=true
# FEATURE_SENTRY_ERROR_TRACKING=true
