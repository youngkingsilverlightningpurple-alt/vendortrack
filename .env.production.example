# ============================================================
# VendorTrack — Production Environment Configuration
# ============================================================
# All required and optional environment variables for
# production deployment. Copy this file to .env.production
# and fill in all values.
#
# SECURITY: This file MUST NOT be committed to version control.
# ============================================================

# ---- Application ----
NODE_ENV=production
PORT=9002
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=warn

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ---- Redis (Production) ----
REDIS_URL=redis://your-redis-host:6379
REDIS_PASSWORD=your-redis-password

# ---- AI (Gemini) ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Monitoring ----
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---- OpenTelemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector:4318
OTEL_SERVICE_NAME=vendortrack
OTEL_TRACES_SAMPLER_RATE=0.1

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://vendortrack.app,https://www.vendortrack.app

# ---- Cookie Security ----
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ---- Feature Flags (Environment Overrides) ----
# FEATURE_STRIPE_CONNECT=true
# FEATURE_AUTO_REFUND_ON_FAILURE=true
# FEATURE_AI_PRODUCT_DESCRIPTIONS=true
# FEATURE_REDIS_CACHING=true
# FEATURE_SENTRY_ERROR_TRACKING=true

# ---- Vercel ----
VERCEL_URL=vendortrack.app
VERCEL_ENV=production

# ---- Background Workers ----
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=5000

# ---- Database ----
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000
DB_MAX_CONNECTIONS=20
DB_POOL_SIZE=10
